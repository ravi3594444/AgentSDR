# Never send secrets or local data into the build context.
.env*
!.env.example
*.dump
*.key
*.pem

.git
.next
node_modules
coverage
output
reports
feedback
.playwright-cli
.claude
.conductor
docs
tests
extensions/*/dist
extensions/*/release

# Migrations run by hand against a database, not from the image — except
# the fresh-install setup the entrypoint runs before the app starts, and the
# upgrade migrations Docker installs run in the container (scheduler, web
# research, the assistant, the handoff). Every script the Dockerfile copies
# must be listed here too, or the image build fails with "not found".
scripts
!scripts/db/setup.ts
!scripts/create-scheduled-job-runs.ts
!scripts/create-lead-research.ts
!scripts/add-mailbox-provider.ts
!scripts/create-assistant-tables.ts
!scripts/add-assistant-automation.ts
!scripts/add-handoff.ts
!scripts/add-instagram-intake-discovery.ts
!scripts/add-instagram-outreach.ts
!scripts/add-assistant-job-reports.ts

README.md

graphify-out
