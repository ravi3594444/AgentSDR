# ─────────────────────────────────────────────────────────────────────────────
# AgentSDR configuration
#
#   Docker Compose:  not this file. Set values in docker-compose.yml or in a
#                    .env next to it, using the names listed there (APP_URL is
#                    Compose-only). See docs/self-hosting/docker-compose.mdx.
#   Local / source:  cp .env.example .env.local   (Next.js and Bun read .env.local)
#
# Values marked REQUIRED must be set when running from source. Generate secrets with
#   openssl rand -hex 32
# Optional settings are commented out at their defaults; uncomment to change.
# Every variable is documented in docs/configuration.md.
#
# Third-party services — Unipile (LinkedIn + WhatsApp), Google Workspace
# (Gmail), Cloudflare R2, OpenRouter (AI), enrichment providers — are NOT
# configured here. Each organization connects its own in Settings →
# Integrations; credentials are stored encrypted in the database.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────

# REQUIRED from source. Docker Compose builds it for the bundled database.
# PostgreSQL 16+. Create the schema in an empty database with `bun run db:setup`.
DATABASE_URL=postgres://agentsdr:change-me@localhost:5432/agentsdr

# TLS to the database is on unless this is "disable" (local and Compose databases).
DATABASE_SSL=disable

# Connections this app may hold. Keep the total across running instances under
# the server's max_connections (a rolling deploy briefly runs two).
# DB_POOL_MAX=8

# Docker Compose only: password for the bundled PostgreSQL (set it in
# docker-compose.yml or a Compose .env, not here).
# POSTGRES_PASSWORD=

# Docker Compose with your own PostgreSQL (a hosted one) instead of the bundled
# one: uncomment, set DATABASE_URL above to it, and set DATABASE_SSL empty.
# See docs/self-hosting/docker-compose.mdx#use-your-own-postgresql.
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml


# ── Public URL ───────────────────────────────────────────────────────────────

# Docker Compose: set APP_URL only (default http://localhost:3000); it fills in
# BETTER_AUTH_URL, NEXT_PUBLIC_APP_URL and OPENROUTER_SITE_URL below.
# APP_URL=https://agentsdr.example.com

# REQUIRED from source. The origin people and webhooks reach this app at, without
# a trailing slash, e.g. https://agentsdr.example.com. Read at runtime for
# sign-in, email links and Unipile redirects.
BETTER_AUTH_URL=http://localhost:3000

# Legacy fallback for the same origin. Prefer BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker Compose only: host port the app is published on.
# PORT=3000


# ── Authentication ───────────────────────────────────────────────────────────

# REQUIRED from source. Signs sessions. Keep it stable — changing it signs everyone out.
BETTER_AUTH_SECRET=

# Who may create accounts: "invite-only" (the default: the first account, then
# only invited email addresses) or "open" (anyone who can reach the instance).
# AUTH_SIGNUP=invite-only

# Auth email (invitations, password reset) via Resend, https://resend.com.
# Needed only to invite people or reset passwords: without it these emails are
# written to the server log instead of sent.
# AUTH_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="AgentSDR <auth@yourdomain.com>"

# Optional "Continue with Google". OAuth client redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Secrets ──────────────────────────────────────────────────────────────────

# REQUIRED from source (back it up with the database). Encrypts every organization's integration credentials. Use the same
# value on every instance sharing the database; changing it makes saved
# integrations unreadable (see `bun run rotate:integration-credentials`).
INTEGRATION_CREDENTIALS_KEY=

# REQUIRED for email outreach from source: signs one-click unsubscribe links.
UNSUBSCRIBE_SECRET=

# OPTIONAL. The scheduled jobs run inside the app, so these are needed only to
# call the job endpoints from outside (an external cron, or a manual run).
# Callers send `Authorization: Bearer <CRON_SECRET>` to /api/linkedin/jobs/*,
# and `x-tick-secret: <OUTREACH_TICK_SECRET>` to /api/outreach/build-queue and
# /api/outreach/mailboxes/watch. Unset, those endpoints refuse every secret call.
# CRON_SECRET=
# OUTREACH_TICK_SECRET=


# ── Background work (optional tuning) ────────────────────────────────────────

# Scheduled jobs (daily rollover, LinkedIn outreach, webhook replay, pruning)
# run inside the app in production. Set to false to turn them off and call the
# endpoints from an external cron instead (then set the two secrets above).
# INTERNAL_SCHEDULER=false
# Docker image only: skip creating the schema in an empty database on start.
# AGENTSDR_SKIP_DB_SETUP=true

# In-process email send loop (production only).
# OUTREACH_TICK_INTERVAL_MS=10000
# Tables enrichment worker.
# GRID_WORKER_POLL_MS=1000
# GRID_WORKER_CONCURRENCY=8
# GRID_CELL_TIMEOUT_MS=30000
# CRM worker (reply classification, drafts, follow-ups).
# CRM_WORKER_POLL_MS=1000
# CRM_WORKER_CONCURRENCY=4
# CRM_WORKER_STALE_LOCK_MS=300000


# ── Phone numbers (optional) ─────────────────────────────────────────────────

# Sending limits are not env. Each organization sets one, its daily lead limit
# (Settings → Daily lead limit); every sender's pacing (emails a day, LinkedIn
# invitations, WhatsApp warm-up and new chats a day, …) is automatic, from
# per-organization rules with safe defaults. Sending runs at any time.

# Country assumed for phone numbers typed without a prefix (ISO 3166-1 alpha-2,
# e.g. US), for organizations that have not chosen one in Settings →
# Your business. Read at runtime.
# DEFAULT_PHONE_COUNTRY=


# ── AI ───────────────────────────────────────────────────────────────────────

# Sent to OpenRouter for request attribution. The OpenRouter connection itself
# is per organization (Settings → AI provider).
# Defaults to APP_URL in Docker Compose.
OPENROUTER_SITE_URL=http://localhost:3000

# Claude Code engine (optional owner-only pilot, docs/plans/CLAUDE_CODE_LOGIN.md):
# the installed `claude` CLI, where each account's own login is kept (a
# persistent, private directory), and how many CLI processes may run at once.
# AGENTSDR_CLAUDE_CODE_CLI=claude
# AGENTSDR_CLAUDE_CODE_DATA_DIR=./.data/claude-code
# AGENTSDR_CLAUDE_CODE_MAX_PROCESSES=2


# ── Lead discovery for the assistant (optional) ─────────────────────────────

# Address of a self-hosted Google Maps scraper (gosom/google-maps-scraper in
# web mode). Docker Compose sets it when docker-compose.discovery.yml is used.
# Unset, the assistant works only with uploaded contact lists. Scraping Google
# Maps is against Google's Terms of Service; see docs/product/OWNER_SETUP.md.
# GMAPS_SCRAPER_URL=http://localhost:8080
# Locates the searched place (a point and an area) so the scraper's fast mode
# can search it in up to 9 circles of at most 20 businesses each. Defaults to
# OpenStreetMap's public Nominatim (free; one request per search); point it at
# a self-hosted Nominatim, or "off" for the scraper's place-page mode, which
# returns empty fields from Google as of October 2026.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Checks each found email's domain for mail servers (MX) before keeping it.
# DISCOVERY_DNS_CHECK=on
# Assistant background jobs (lead searches, outreach starts).
# ASSISTANT_WORKER_POLL_MS=3000
# Automatic replies (outreach runs started in Automatic mode) send only in
# production; true lets a staging copy send too.
# AUTOPILOT_ALLOW_NON_PRODUCTION=false


# ── Prospecting (domain qualification; optional, being retired) ──────────────

# APOLLO_API_KEY=
# APOLLO_BASE_URL=https://api.apollo.io/api/v1
# APOLLO_THROTTLE_MS=0
# ADS_PROVIDER=mock
# ADS_API_KEY=
# ADS_BASE_URL=


# ── Kill switches (leave false) ──────────────────────────────────────────────

# Pause outbound work without a deploy, e.g. during a data migration.
# PEOPLE_MIGRATION_MODE pauses everything listed below at once.
PEOPLE_MIGRATION_MODE=false
PAUSE_CAMPAIGN_MUTATIONS=false
PAUSE_EMAIL_OUTBOUND=false
PAUSE_INSTAGRAM_OUTBOUND=false
PAUSE_LINKEDIN_OUTBOUND=false
PAUSE_LINKEDIN_RESOLUTION=false
PAUSE_LINKEDIN_SEARCH=false
PAUSE_GRID_WORKER=false

# ── Public demo ──────────────────────────────────────────────────────────────

# Only for a separate deployment whose database holds nothing but
# `bun run db:seed:demo`: signs every visitor in as the demo user, read-only.
# See docs/self-hosting/demo.mdx. Never on a database with real data.
DEMO_MODE=false
