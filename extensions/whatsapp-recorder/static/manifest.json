{
  "manifest_version": 3,
  "name": "22nd x ai Browser Assistant",
  "version": "0.19.0",
  "description": "Lets the 22nd x ai assistant work on the websites you allow in Chrome, and places and records WhatsApp calls you start in 22nd x ai.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "tabGroups",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://app.agentsdr.ai/*",
    "http://localhost:3000/*",
    "https://web.whatsapp.com/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "22nd x ai Browser Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.agentsdr.ai/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa-agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
