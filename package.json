{
  "name": "agentsdr",
  "version": "0.3.1",
  "private": true,
  "description": "Open-source AI sales development platform: lead database, email, LinkedIn and WhatsApp outreach, and an AI-assisted CRM, for teams that self-host.",
  "license": "MIT",
  "homepage": "https://github.com/Kandid-ai/AgentSDR#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kandid-ai/AgentSDR.git"
  },
  "bugs": {
    "url": "https://github.com/Kandid-ai/AgentSDR/issues"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "bun run package:recorder && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=react-server",
    "db:setup": "bun scripts/db/setup.ts",
    "db:seed:demo": "bun --conditions=react-server scripts/db/seed-demo.ts",
    "db:schema:dump": "bun scripts/db/dump-schema.ts",
    "db:check": "bun scripts/check-organization-scope.ts --contract",
    "preflight:people": "bun --conditions=react-server scripts/preflight-people-migration.ts",
    "postflight:people": "bun --conditions=react-server scripts/verify-people-migration.ts",
    "snapshot:outreach": "bun --conditions=react-server scripts/snapshot-active-outreach.ts",
    "audit:email-people-parity": "bun --conditions=react-server scripts/audit-email-people-parity.ts",
    "audit:linkedin-people-parity": "bun --conditions=react-server scripts/audit-linkedin-migration-parity.ts",
    "replay:linkedin-webhooks": "bun --conditions=react-server scripts/replay-linkedin-webhooks.ts",
    "cleanup:crm-identity": "bun scripts/cleanup-crm-identity-exceptions.ts",
    "resolve:legacy-linkedin": "bun --conditions=react-server scripts/resolve-legacy-linkedin-identifiers.ts",
    "rollback:people": "bun --conditions=react-server scripts/rollback-people-migration.ts",
    "export:people-reconciliation": "bun --conditions=react-server scripts/export-people-migration-reconciliation.ts",
    "rotate:integration-credentials": "bun scripts/rotate-integration-credentials.ts",
    "test:integrations:live": "bun --conditions=react-server scripts/test-integrations-live.ts",
    "build:recorder": "rm -rf extensions/whatsapp-recorder/dist && bun build extensions/whatsapp-recorder/src/background.ts extensions/whatsapp-recorder/src/wa-hook.ts extensions/whatsapp-recorder/src/wa-agent.ts extensions/whatsapp-recorder/src/bridge.ts extensions/whatsapp-recorder/src/options.ts extensions/whatsapp-recorder/src/update.ts extensions/whatsapp-recorder/src/connect.ts extensions/whatsapp-recorder/src/popup.ts --outdir extensions/whatsapp-recorder/dist --target browser --format iife && cp extensions/whatsapp-recorder/static/* extensions/whatsapp-recorder/dist/",
    "package:recorder": "bun run build:recorder && bun extensions/whatsapp-recorder/package.ts",
    "release:prepare": "bun scripts/release/prepare-public-repo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@formulajs/formulajs": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "4.9.0",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "axios": "^1.19.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^174.0.0",
    "js-base64": "^3.9.2",
    "libphonenumber-js": "^1.13.14",
    "lodash": "^4.18.1",
    "lucide-react": "^1.34.0",
    "mammoth": "1.13.0",
    "moment": "^2.30.1",
    "next": "16.2.9",
    "nodemailer": "^9.0.4",
    "openai": "6.45.0",
    "playwright-core": "1.63.0",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "unipile-node-sdk": "^1.9.3",
    "unpdf": "1.8.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fflate": "^0.8.3",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
